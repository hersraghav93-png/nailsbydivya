# ==============================================================================
# NAILS BY DIVYA — CLIENT-SIDE ENVIRONMENT CONFIGURATION (.env.example)
# Public Web App Identifiers for Firebase Client SDK & Backend API
#
# IMPORTANT:
# - These are PUBLIC web API identifiers needed by the browser to connect to Firebase.
# - NEVER put Firebase Admin private keys, service account JSON, or secrets here.
# - Copy to .env or configure in your deployment platform (e.g. GitHub Pages, Vercel, Netlify).
# ==============================================================================

# Backend API URL
# Local Development: http://localhost:5000
# Production: https://nails-ai-backend.onrender.com
NAILS_API_URL=http://localhost:5000

# Firebase Web App Configuration
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxx
